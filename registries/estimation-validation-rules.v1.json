    {"rule_id": "est.handoff.entry_codes_clear", "wall": 1, "kind": "handoff",
     "code": "entry_validation_failed", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"check": "entry_codes_clear", "path": "/handoff/entries"}},

    {"rule_id": "est.handoff.hashes_match", "wall": 1, "kind": "handoff",
     "code": "handoff_hash_mismatch", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"check": "handoff_hashes_match", "path": "/context_manifest"}},

    {"rule_id": "est.plan.committed", "wall": 2, "kind": "plan",
