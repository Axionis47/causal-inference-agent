      "sensitivity_branches": [
        {"branch_id": "unadjusted_itt", "purpose": "unadjusted against approved adjusted ITT",
         "parameter_delta": {"specification": "difference_in_means"},
         "comparison_rule_id": "sign_and_interval_stability"},
        {"branch_id": "sensitivity_covariance_profile",
         "purpose": "prespecified alternative covariance profile",
         "parameter_delta": {"cluster_covariance": "cluster_robust_cr3"},
         "comparison_rule_id": "interval_width_stability"},
        {"branch_id": "leave_one_cluster_out", "purpose": "cluster influence summary",
         "parameter_delta": {"influence_summary": "leave_one_cluster_out"},
         "comparison_rule_id": "influence_stability"},
        {"branch_id": "bounded_missing_outcome", "purpose": "bounded attrition sensitivity",
         "parameter_delta": {"missing_outcome_rule": "bounded_worst_case"},
         "comparison_rule_id": "bound_containment"},
        {"branch_id": "approved_subgroup_contrast", "purpose": "subgroups declared in the design",
         "parameter_delta": {"subgroup_scope": "approved_design_subgroups"},
         "comparison_rule_id": "descriptive_only"}
      ],
      "figure_builder_ids": [
        "assignment_attrition_counts", "arm_summary_table", "balance_measures",
        "primary_contrast_intervals", "multiplicity_disclosure"
      ],
      "not_estimable_rule_ids": [
        "arm_without_contributing_rows", "comparator_without_contributing_rows",
        "outcome_never_observed"
      ],
      "invalidation_rule_ids": [
        "post_randomization_exclusion_detected", "cluster_mapping_unresolved",
        "multiplicity_policy_missing"
      ]
    },
    {
