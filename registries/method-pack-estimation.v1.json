{
  "registry_version": "method-pack-estimation.v1",
  "packs": [
    {
      "method_id": "randomized_experiment",
      "pack_version": "randomized-experiment-pack.v1",
      "estimator_id": "itt_contrast_estimator",
      "estimator_version": "itt-contrast-estimator.v1",
      "parameter_defaults": {
        "specification": "ancova_when_baseline_approved", "outcome_scale": "difference",
        "stratum_handling": "fixed_effects", "cluster_covariance": "cluster_robust_cr2",
        "minimum_clusters": 8, "mask_rule_id": "outcome_observed",
        "multiplicity_policy_id": "holm_step_down.v1"
      },
      "estimator_input_schema": {
        "treatment": ["categorical", "binary"], "outcome": ["numeric", "binary"],
        "unit_identifier": ["identifier"], "stratum": ["categorical"],
        "cluster": ["identifier"], "precision_covariate": ["numeric", "categorical"]
      },
      "allowed_mask_rule_ids": ["outcome_observed", "arm_membership", "stratum_cell"],
      "uncertainty_method": "analytic_robust_variance",
      "finite_sample_correction": "hc2_cr2",
      "confidence_level": 0.95,
      "estimator_profiles": [],
      "nuisance_profiles": [],
      "fold_count_default": null,
      "required_diagnostics": [
        {"diagnostic_id": "randomization_unit_reconciliation",
         "severity": "required_blocking", "threshold_params": {}},
        {"diagnostic_id": "arm_cluster_stratum_contribution_counts",
         "severity": "required_blocking", "threshold_params": {}},
        {"diagnostic_id": "baseline_balance", "severity": "descriptive", "threshold_params": {}},
        {"diagnostic_id": "outcome_attrition_by_arm", "severity": "qualification_guard",
         "threshold_params": {"max_overall_attrition": 0.2, "max_differential_attrition": 0.1}},
        {"diagnostic_id": "covariance_cluster_adequacy", "severity": "invalidation_guard",
         "threshold_params": {"minimum_clusters": 8}},
        {"diagnostic_id": "influential_cluster_leverage", "severity": "qualification_guard",
         "threshold_params": {"max_single_cluster_leverage_share": 0.25}},
        {"diagnostic_id": "model_convergence_integrity", "severity": "required_blocking", "threshold_params": {}},
        {"diagnostic_id": "multiplicity_handling", "severity": "required_blocking", "threshold_params": {}}
