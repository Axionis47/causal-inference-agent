{
  "registry_version": "design-validators.v1",
  "rules": [
    {"rule_id": "temporal.post_treatment_adjustment", "wall": 4, "kind": "temporal",
     "code": "post_treatment_role_forbidden", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["confounder_candidate", "precision_covariate", "assignment_variable"],
                "timings": ["post_treatment"], "relation": "forbidden"}},

    {"rule_id": "temporal.mediator_is_post_treatment", "wall": 4, "kind": "temporal",
     "code": "mediator_timing_invalid", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["mediator"], "timings": ["post_treatment"], "relation": "required"}},

    {"rule_id": "temporal.outcome_not_pre_treatment", "wall": 4, "kind": "temporal",
     "code": "outcome_timing_invalid", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["outcome"], "timings": ["pre_treatment"], "relation": "forbidden"}},

    {"rule_id": "temporal.running_variable_precedes_assignment", "wall": 4, "kind": "temporal",
     "code": "running_variable_timing_invalid", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["running_variable"], "timings": ["pre_treatment", "concurrent"],
                "relation": "required"}},

    {"rule_id": "temporal.treatment_is_concurrent", "wall": 4, "kind": "temporal",
     "code": "treatment_timing_invalid", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"roles": ["treatment"], "timings": ["concurrent"], "relation": "required"}},

    {"rule_id": "role_graph.confounder_candidate", "wall": 5, "kind": "role_graph",
     "code": "confounder_edges_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "confounder_candidate",
                "statuses": ["evidenced", "hypothesis", "disputed", "unknown"],
                "required_edges": [["concept", "treatment"], ["concept", "outcome"]],
                "correction_detail": "A confounder claim requires selected-graph edges from that concept to both the frame treatment and frame outcome. If either edge is absent, remove or reclassify the claim; do not invent an edge or add an unrelated edge id."}},

    {"rule_id": "role_graph.treatment", "wall": 5, "kind": "role_graph",
     "code": "causal_target_edge_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence"],
     "params": {"role": "treatment", "statuses": ["evidenced", "hypothesis"],
                "required_edges": [["concept", "outcome"]],
                "correction_detail": "The selected graph must connect the treatment anchor to the outcome anchor. Add the supported causal-target edge or stop; do not invent a relationship."}},

    {"rule_id": "role_graph.mediator", "wall": 5, "kind": "role_graph",
     "code": "mediator_edges_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "mediator",
                "statuses": ["evidenced", "hypothesis", "disputed", "unknown"],
                "required_edges": [["treatment", "concept"], ["concept", "outcome"]],
                "correction_detail": "A mediator claim requires selected-base-graph edges from treatment to the concept and from the concept to outcome. If either edge is absent, remove the optional claim; an alternative graph does not satisfy this role."}},

    {"rule_id": "role_graph.collider", "wall": 5, "kind": "role_graph",
     "code": "collider_edges_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "collider",
                "statuses": ["evidenced", "hypothesis", "disputed", "unknown"],
                "required_edges": [["treatment", "concept"], ["outcome", "concept"]]}},

    {"rule_id": "role_graph.instrument_candidate", "wall": 5, "kind": "role_graph",
     "code": "instrument_exclusion_violated", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "instrument_candidate", "statuses": ["evidenced"],
                "required_edges": [["concept", "treatment"]],
                "forbidden_edges": [["concept", "outcome"]]}}
  ]
}
