{
  "registry_version": "design-validators.v1",
  "rules": [
    {"rule_id": "temporal.post_treatment_adjustment", "wall": 4, "kind": "temporal",
     "code": "post_treatment_role_forbidden", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["confounder_candidate", "precision_covariate", "assignment_variable"],
                "timings": ["post_treatment"], "relation": "forbidden"}},

    {"rule_id": "temporal.mediator_is_post_treatment", "wall": 4, "kind": "temporal",
     "code": "mediator_timing_invalid", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["mediator"], "timings": ["post_treatment"], "relation": "required"}},

    {"rule_id": "temporal.outcome_not_pre_treatment", "wall": 4, "kind": "temporal",
     "code": "outcome_timing_invalid", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["outcome"], "timings": ["pre_treatment"], "relation": "forbidden"}},

    {"rule_id": "temporal.running_variable_precedes_assignment", "wall": 4, "kind": "temporal",
     "code": "running_variable_timing_invalid", "user_resolvable": true,
     "allowed_actions": ["revise_field", "relabel_epistemic_status", "request_context"],
     "params": {"roles": ["running_variable"], "timings": ["pre_treatment", "concurrent"],
                "relation": "required"}},

    {"rule_id": "role_graph.confounder_candidate", "wall": 5, "kind": "role_graph",
     "code": "confounder_edges_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "confounder_candidate",
                "statuses": ["evidenced", "hypothesis", "disputed", "unknown"],
                "required_edges": [["concept", "treatment"], ["concept", "outcome"]]}},

    {"rule_id": "role_graph.mediator", "wall": 5, "kind": "role_graph",
     "code": "mediator_edges_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "mediator",
                "statuses": ["evidenced", "hypothesis", "disputed", "unknown"],
                "required_edges": [["treatment", "concept"], ["concept", "outcome"]]}},

    {"rule_id": "role_graph.collider", "wall": 5, "kind": "role_graph",
     "code": "collider_edges_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "collider",
                "statuses": ["evidenced", "hypothesis", "disputed", "unknown"],
                "required_edges": [["treatment", "concept"], ["outcome", "concept"]]}},

    {"rule_id": "role_graph.instrument_candidate", "wall": 5, "kind": "role_graph",
     "code": "instrument_exclusion_violated", "user_resolvable": false,
     "allowed_actions": ["revise_field", "add_evidence", "remove_claim"],
     "params": {"role": "instrument_candidate", "statuses": ["evidenced"],
                "required_edges": [["concept", "treatment"]],
                "forbidden_edges": [["concept", "outcome"]]}},

    {"rule_id": "method.one_row_per_unit", "wall": 6, "kind": "method_structural",
     "code": "structural_unit_grain_unmet", "user_resolvable": true,
     "allowed_actions": ["revise_field", "request_context"],
     "params": {"requirement": "one_row_per_unit", "roles": ["unit_identifier"],
                "diagnostics": ["assignment_unit_uniqueness", "duplicates",
                                "unit_period_uniqueness"]}},

    {"rule_id": "method.unit_time_or_group_time_rows", "wall": 6, "kind": "method_structural",
     "code": "structural_panel_grain_unmet", "user_resolvable": true,
     "allowed_actions": ["revise_field", "request_context"],
     "params": {"requirement": "unit_time_or_group_time_rows", "roles": ["unit_identifier", "time"],
                "diagnostics": ["unit_period_uniqueness", "group_time_counts",
                                "panel_completeness"]}},

    {"rule_id": "method.running_variable_with_cutoff", "wall": 6, "kind": "method_structural",
     "code": "structural_running_variable_unmet", "user_resolvable": true,
     "allowed_actions": ["revise_field", "request_context"],
     "params": {"requirement": "running_variable_with_cutoff", "roles": ["running_variable"],
                "diagnostics": ["cutoff_side_counts", "distance_to_cutoff_support"]}},

    {"rule_id": "method.arms_ge_2", "wall": 6, "kind": "method_structural",
     "code": "structural_arms_unmet", "user_resolvable": true,
     "allowed_actions": ["revise_field", "request_context"],
     "params": {"requirement": "arms_ge_2", "roles": ["treatment"],
                "diagnostics": ["arm_counts", "treatment_prevalence"]}},

    {"rule_id": "method.treatment_binary", "wall": 6, "kind": "method_structural",
     "code": "structural_treatment_binary_unmet", "user_resolvable": true,
     "allowed_actions": ["revise_field", "request_context"],
     "params": {"requirement": "treatment_binary", "roles": ["treatment"],
                "diagnostics": ["treatment_prevalence", "arm_counts", "level_sparsity"]}},

    {"rule_id": "frame.exclusion_reason_vocabulary", "wall": 7, "kind": "frame_subset",
     "code": "exclusion_vocabulary_incomplete", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/exclusion_reason_vocabulary",
                "left": "contract.exclusion_reason_vocabulary",
                "right": "pack.eligibility_rule_vocabulary"}},

    {"rule_id": "frame.deletion_impact_dimensions", "wall": 7, "kind": "frame_subset",
     "code": "deletion_dimensions_incomplete", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/deletion_impact_dimensions",
                "left": "contract.deletion_impact_dimensions",
                "right": "pack.deletion_impact_dimensions"}},

    {"rule_id": "frame.required_final_diagnostics", "wall": 7, "kind": "frame_subset",
     "code": "postrepair_diagnostics_incomplete", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/required_final_diagnostics",
                "left": "contract.required_final_diagnostics",
                "right": "pack.required_postrepair_diagnostic_ids"}},

    {"rule_id": "frame.required_visual_evidence", "wall": 7, "kind": "frame_subset",
     "code": "visual_evidence_incomplete", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/required_visual_evidence",
                "left": "design.required_visual_evidence",
                "right": "pack.required_visual_evidence_ids"}},

    {"rule_id": "frame.imputation_lists_disjoint", "wall": 7, "kind": "frame_subset",
     "code": "imputation_lists_overlap", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "disjoint", "path": "/imputation_permitted",
                "left": "contract.imputation_permitted",
                "right": "contract.imputation_forbidden"}},

    {"rule_id": "frame.imputation_forbidden_columns", "wall": 7, "kind": "frame_subset",
     "code": "imputation_forbidden_incomplete", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/imputation_forbidden",
                "left": "contract.imputation_forbidden",
                "right": "ledger.imputation_forbidden_columns"}},

    {"rule_id": "frame.key_columns_in_inventory", "wall": 7, "kind": "frame_subset",
     "code": "unknown_key_column", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/key_columns", "left": "manifest.inventory_columns",
                "right": "contract.key_columns"}},

    {"rule_id": "frame.output_grain_present", "wall": 7, "kind": "frame_subset",
     "code": "frame_grain_missing", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "nonempty", "path": "/output_grain", "left": "contract.output_grain"}},

    {"rule_id": "frame.experiment_design_hash", "wall": 7, "kind": "frame_subset",
     "code": "design_hash_mismatch", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/experiment_design_hash",
                "left": "parents.content_hashes", "right": "contract.experiment_design_hash"}},

    {"rule_id": "frame.estimator_input_schema", "wall": 7, "kind": "frame_subset",
     "code": "estimator_schema_mismatch", "user_resolvable": false,
     "allowed_actions": ["revise_field"],
     "params": {"op": "superset", "path": "/estimator_input_schema",
                "left": "contract.estimator_input_schema",
                "right": "pack.reserved_estimator_id"}}
  ]
}
