# Copy to .env. Everything here has a local default; only LangSmith needs a key, and only for tracing.

# Gemini on Vertex AI. Auth comes from `gcloud auth application-default login`.
# VERTEX_PROJECT falls back to the active gcloud project when unset.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# The light tier: the per-turn reading of the person's words. Unset, the model above serves both tiers.
# GEMINI_MODEL_LIGHT=gemini-2.5-flash-lite

# The decision model that reads what kind of turn each message is, with a calibrated confidence, before any Gemini call:
# laya (the open checkpoint, in this process; the first call loads it) or jev (a hosted endpoint on the same wire).
DECIDER=laya
# DECIDER_URL=
# DECIDER_KEY=

# Thoughts: debug only. On in dev, off for eval runs.
INCLUDE_THOUGHTS=true
THINKING_BUDGET=1024

# Frame width budget: columns beyond this trigger the prefilter fan-out.
FRAME_WIDTH_BUDGET=150

# LangSmith tracing. Studio works without it; traces and evals need it.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=causal-agent

# Where specialist runs write their artifacts (table, design, estimates, report). Git-ignored.
RUN_DIR=.artifacts/runs

# Docker is required for generated scripts: no network, read-only inputs, bounded resources. Build with make explore-image.
EXPLORE_IMAGE=causal-desk-explore
# Compose supplies EXPLORE_QUEUE=/queue and EXPLORE_AGENT_URL internally.
# Leave those unset for local disposable Docker execution.

# Owned ingestion only. Initialize with python -m causal_agent.server.ingestion init.
# Compose provides isolated local development services and credentials.
APP_ENV=development
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DATABASE_URL=
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=datasets
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_ROWS=100000
UPLOAD_MAX_COLUMNS=200
UPLOAD_MAX_CELLS=5000000
