# Vertex AI is the only model provider used by the preparation ReAct agent.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
PREPARATION_MODEL=gemini-2.5-flash

# Authenticate locally with Application Default Credentials:
#   gcloud auth application-default login

# Optional observability.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=causal-studio
# LANGSMITH_API_KEY=...

# Tests/offline development only. Production should leave this unset.
# PREPARATION_OFFLINE=true
