DB_PASSWORD=replace-with-a-random-local-database-password
DATABASE_URL=postgresql+psycopg://causal:replace-with-a-random-local-database-password@127.0.0.1:55478/causal
STORAGE_DIR=.runtime/files
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5178,http://localhost:5178,http://127.0.0.1:8008
BOOTSTRAP_EMAIL=demo@example.com
BOOTSTRAP_PASSWORD=replace-with-a-password-of-at-least-12-characters
VERTEX_PROJECT=your-google-cloud-project
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Absolute path to Application Default Credentials, mounted read-only in the local worker.
VERTEX_ADC_FILE=/absolute/path/to/application_default_credentials.json
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=causal-context
LANGSMITH_API_KEY=your-langsmith-key
# Local ARM Docker compatibility. Portable OpenSSL operations keep current security fixes.
OPENSSL_ARM_CAP=0
